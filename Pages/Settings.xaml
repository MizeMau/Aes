<Page x:Class="Aes.Pages.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Settings">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Background="#0F1B2B">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="⚙️ Category Management"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,20"/>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Form -->
            <Border Background="#1E2A3A"
                    CornerRadius="12"
                    Padding="20"
                    BorderBrush="#31445E"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Add / Edit Category"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#A8C3F0"
                               Margin="0,0,0,10"/>

                    <!-- Name -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Name" Foreground="#BFD2FF" FontSize="14"/>
                        <TextBox Text="{Binding SelectedCategory.Name, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,5,0,0"
                                 Padding="6"
                                 Background="#26364A"
                                 Foreground="White"
                                 BorderBrush="#3A4B63"/>
                    </StackPanel>

                    <!-- Planned Amount -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Planned Amount (€)" Foreground="#BFD2FF" FontSize="14"/>
                        <TextBox Text="{Binding SelectedCategory.PlannedAmount, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,5,0,0"
                                 Padding="6"
                                 Background="#26364A"
                                 Foreground="White"
                                 BorderBrush="#3A4B63"/>
                    </StackPanel>

                    <!-- Type & Color -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="120">
                            <TextBlock Text="Type" Foreground="#BFD2FF" FontSize="14"/>

                            <ComboBox Margin="0,0,0,10"
                                      Padding="6"
                                      ItemsSource="{Binding CategoryTypes}"
                                      SelectedItem="{Binding SelectedCategory.Type, Mode=TwoWay}"
                                      Foreground="White"
                                      Background="Transparent"
                                      BorderBrush="#afafaf"
                                      BorderThickness="1">
                                <ComboBox.Template>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <ToggleButton x:Name="PART_Button"
                                                          Grid.Column="0"
                                                          Background="{TemplateBinding Background}"
                                                          BorderBrush="{TemplateBinding BorderBrush}"
                                                          BorderThickness="{TemplateBinding BorderThickness}"
                                                          Focusable="False"
                                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                          Padding="{TemplateBinding Padding}">
                                                <ToggleButton.Resources>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="CornerRadius" Value="10"/>
                                                    </Style>
                                                </ToggleButton.Resources>
                                                <Grid Width="300">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Margin="6,0,25,0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}"
                                                               Foreground="{TemplateBinding Foreground}" />
                                                    <Path Grid.Column="1"
                                                          Margin="0,0,10,0"
                                                          VerticalAlignment="Center"
                                                          Data="M 0 0 L 6 6 L 12 0 Z"
                                                          Fill="White"
                                                          Width="12"
                                                          Height="6"/>
                                                </Grid>
                                            </ToggleButton>

                                            <!-- Dropdown -->
                                            <Popup x:Name="PART_Popup"
                                                   Placement="Bottom"
                                                   Width="320"
                                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                                   AllowsTransparency="True"
                                                   Focusable="False"
                                                   PopupAnimation="Slide">
                                                <Border CornerRadius="8"
                                                        Background="#222222EE"
                                                        BorderBrush="White"
                                                        BorderThickness="1"
                                                        Margin="0,2,0,0">
                                                    <ScrollViewer>
                                                        <ItemsPresenter />
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </Grid>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="PART_Button" Property="BorderBrush" Value="#AAAAAA"/>
                                            </Trigger>
                                            <Trigger Property="IsDropDownOpen" Value="True">
                                                <Setter TargetName="PART_Button" Property="BorderBrush" Value="#5FA8FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ComboBox.Template>


                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ComboBoxItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                                        <TextBlock Text="{Binding}" Margin="6,0"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#333"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#444"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>

                        </StackPanel>

                        <StackPanel Width="100">
                            <TextBlock Text="Color" Foreground="#BFD2FF" FontSize="14"/>
                            <TextBox Text="{Binding SelectedCategory.Color, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,5,0,0"
                                     Padding="6"
                                     Background="#26364A"
                                     Foreground="White"
                                     BorderBrush="#3A4B63"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <!-- Always visible Add -->
                        <Button Content="➕ Add" Command="{Binding AddCommand}" 
                                Visibility="{Binding IsCategorySelectedNeg, Converter={StaticResource BoolToVis}}"
                                Background="#4CAF50" Foreground="White" Padding="8,4" BorderThickness="0"/>

                        <!-- Visible only when a category is selected -->
                        <Button Content="✏️ Update"
                                Command="{Binding UpdateCommand}"
                                Visibility="{Binding IsCategorySelected, Converter={StaticResource BoolToVis}}"
                                Background="#2196F3" Foreground="White" Padding="8,4" BorderThickness="0"/>

                        <Button Content="🗑️ Delete"
                                Command="{Binding DeleteCommand}"
                                Visibility="{Binding IsCategorySelected, Converter={StaticResource BoolToVis}}"
                                Background="#F44336" Foreground="White" Padding="8,4" BorderThickness="0"/>

                        <!-- Cancel button -->
                        <Button Content="❌ Cancel"
                                Command="{Binding CancelCommand}"
                                Background="#F44336" Foreground="White" Padding="8,4" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Table -->
            <Border Grid.Column="1"
                    Background="#1E2A3A"
                    CornerRadius="12"
                    Padding="20"
                    BorderBrush="#31445E"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Existing Categories"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#A8C3F0"
                               Margin="0,0,0,10"/>

                    <DataGrid ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              Foreground="White"
                              RowBackground="#223043"
                              AlternatingRowBackground="#26364A"
                              SelectionMode="Single"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              RowHeight="32"
                              IsReadOnly="True">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E2A3A"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding TransactionCategoryID}" Width="Auto"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Planned" Binding="{Binding PlannedAmount}" Width="Auto"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto"/>
                            <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
