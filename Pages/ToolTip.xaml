<UserControl x:Class="Aes.Pages.ToolTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="Auto" Height="Auto">
    <Border CornerRadius="5" Background="Black" Padding="5">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Color box -->
            <Ellipse Width="15" Height="15" Fill="{Binding Fill}" Margin="0,0,5,0"/>
            <!-- Value text -->
            <TextBlock Foreground="White" FontWeight="Bold" Text="{Binding Value}"/>
        </StackPanel>
    </Border>
</UserControl>
