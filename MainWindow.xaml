<Window x:Class="Aes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Aes"
        mc:Ignorable="d"
        Background="#0f1724"
        Foreground="#98a0b3"
        FontSize="30"
        Title="Aes"
        Height="1080"
        Width="1920"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Main Content Area -->
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>

        <!-- Top Bar -->
        <Grid Background="Transparent" Height="60" VerticalAlignment="Top">

            <!-- Settings Button -->
            <Button x:Name="SettingsButton"
                    Content="⚙️"
                    FontSize="28"
                    Width="50"
                    Height="50"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="#cbd5e1"
                    HorizontalAlignment="Right"
                    Margin="0,0,20,0"
                    Cursor="Hand"
                    Click="SettingsButton_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Side Navigation Panel -->
        <Border x:Name="SideMenu"
                Background="#0f1724"
                Width="220"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Left"
                RenderTransformOrigin="0,0"
                BorderBrush="Gray" 
            BorderThickness="0,0,1,0" >
            <Border.RenderTransform>
                <TranslateTransform x:Name="SideMenuTransform" X="-220"/>
            </Border.RenderTransform>

            <StackPanel Margin="10,70,10,10">
                <Button Content="🏠  Home"
                        Margin="0,10,0,0"
                        Padding="10"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="Transparent"
                        FontSize="26"
                        HorizontalContentAlignment="Left"
                        Click="HomePageButton_Click"/>

                <Button Content="⚙️  Settings"
                        Margin="0,10,0,0"
                        Padding="10"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="Transparent"
                        FontSize="26"
                        HorizontalContentAlignment="Left"
                        Click="SettingsPageButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
